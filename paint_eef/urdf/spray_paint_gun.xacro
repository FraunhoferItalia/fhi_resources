<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spray_paint_gun">
  <xacro:macro name="spray_paint_gun" params="name parent *origin">

    <joint name="spray_paint_gun_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="end_effector_link"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    </joint>

    <link name="end_effector_link">
      <inertial>
        <mass value="0.0001" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi} ${pi/2}" />
        <geometry>
          <mesh filename="package://concert_tool_descriptions/meshes/spray_gun_eef.obj" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <!-- todo, commented because of gazebo not able to spawn robot joints in initial states and thus crashing because of collision-->
      <!--<collision>
        <origin xyz="0 0 0" rpy="0 ${pi} ${pi/2}" />
        <geometry>
          <mesh filename="package://concert_tool_descriptions/meshes/spray_gun_eef.obj" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>-->
    </link>


    <joint name="spray_nozzle_link_joint" type="fixed">
      <parent link="end_effector_link"/>
      <child link="spray_nozzle_link"/>
      <origin rpy="0 0 0" xyz="0.05 -0.1 0.2"/>
    </joint>

    <link name="spray_nozzle_link">
    </link>
  </xacro:macro>
</robot>
